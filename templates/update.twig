{% extends "layouts/base.twig" %}

{% block title %}Редактирование заказа #{{ order.id }}{% endblock %}

{% block content %}
    <a href="/order" class="btn-back">
        <i class="bi bi-arrow-left"></i>
        Вернуться к заказам
    </a>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-transparent border-0 pt-4">
                    <h2 class="text-center fw-bold">
                        <i class="bi bi-pencil-square me-2" style="color: var(--primary-color);"></i>
                        Редактирование заказа #{{ order.id }}
                    </h2>
                </div>

                <div class="card-body p-4">
                    {% if error is defined %}
                        <div class="alert alert-danger">{{ error }}</div>
                    {% endif %}

                    <form method="post" action="/order/update/{{ order.id }}">
                        <div class="mb-4">
                            <label for="product_name" class="form-label fw-bold">
                                <i class="bi bi-tag me-2"></i>Товар
                            </label>
                            <input type="text"
                                   class="form-control bg-light"
                                   id="product_name"
                                   value="{{ order.product_name }}"
                                   readonly>
                        </div>

                        <div class="mb-4">
                            <label for="address" class="form-label fw-bold">
                                <i class="bi bi-geo-alt me-2"></i>Адрес доставки
                            </label>
                            <textarea class="form-control bg-light"
                                      id="address"
                                      rows="3"
                                      readonly>{{ order.address }}</textarea>
                        </div>

                        <div class="mb-4">
                            <label for="status" class="form-label fw-bold">
                                <i class="bi bi-flag me-2"></i>Статус заказа
                            </label>
                            <select class="form-select" id="status" name="status" required>
                                <option value="open" {% if order.status == 'open' %}selected{% endif %}>
                                    🔄 В обработке
                                </option>
                                <option value="completed" {% if order.status == 'completed' %}selected{% endif %}>
                                    ✅ Выполнен
                                </option>
                                <option value="cancelled" {% if order.status == 'cancelled' %}selected{% endif %}>
                                    ❌ Отменен
                                </option>
                            </select>
                            <div class="form-text text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                Можно изменить только статус заказа
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-grow-1 py-2">
                                <i class="bi bi-check-circle me-2"></i>
                                Сохранить изменения
                            </button>
                            <a href="/order" class="btn btn-outline-secondary py-2">
                                <i class="bi bi-x-circle me-2"></i>
                                Отмена
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <style>
        .form-control, .form-select {
            border: 2px solid #e9ecef;
            border-radius: 12px;
            padding: 12px 16px;
            transition: all 0.3s ease;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.2rem rgba(67, 97, 238, 0.25);
        }

        .form-control.bg-light {
            background-color: #f8f9fa;
            border-color: #dee2e6;
            color: #495057;
        }

        textarea.form-control.bg-light {
            resize: none;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            border: none;
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(67, 97, 238, 0.4);
        }

        .btn-outline-secondary {
            border-width: 2px;
            border-radius: 12px;
            font-weight: 600;
        }

        .form-text {
            font-size: 0.85rem;
            margin-top: 6px;
        }
    </style>
{% endblock %}