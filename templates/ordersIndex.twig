{% extends "layouts/base.twig" %}

{% block title %}Все заказы{% endblock %}

{% block content %}
    <h1>
        <i class="bi bi-truck me-2" style="color: var(--primary-color);"></i>
        Мои заказы
    </h1>

    {% if orders is empty %}
        <div class="alert alert-info text-center p-5 rounded-4">
            <i class="bi bi-inbox display-1 d-block mb-3" style="color: var(--primary-color);"></i>
            <h3>У вас пока нет заказов</h3>
            <p class="mb-4">Перейдите в каталог, чтобы выбрать товары</p>
            <a href="/catalog" class="btn btn-primary btn-lg">
                <i class="bi bi-shop me-2"></i>
                Перейти в каталог
            </a>
        </div>
    {% else %}
        <div class="row g-4">
            {% for order in orders %}
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm order-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge {% if order.status == 'open' %}bg-warning{% elseif order.status == 'completed' %}bg-success{% else %}bg-secondary{% endif %} rounded-pill px-3 py-2">
                                    <i class="bi
                                        {% if order.status == 'open' %}bi-clock-history
                                        {% elseif order.status == 'completed' %}bi-check-circle
                                        {% else %}bi-question-circle{% endif %}
                                        me-1">
                                    </i>
                                    {% if order.status == 'open' %}
                                        В обработке
                                    {% elseif order.status == 'completed' %}
                                        Выполнен
                                    {% else %}
                                        {{ order.status }}
                                    {% endif %}
                                </span>
                                <small class="text-muted">#{{ order.id }}</small>
                            </div>

                            <h5 class="card-title fw-bold mb-3">
                                <i class="bi bi-box-seam me-2" style="color: var(--primary-color);"></i>
                                {{ order.product_name }}
                            </h5>

                            <div class="mb-3">
                                <small class="text-muted d-block">
                                    <i class="bi bi-geo-alt me-1"></i>Адрес доставки:
                                </small>
                                <p class="mb-0">{{ order.address }}</p>
                            </div>

                            <div class="d-flex gap-2 mt-3">
                                <a href="/order/update/{{ order.id }}" class="btn btn-outline-primary flex-grow-1">
                                    <i class="bi bi-pencil me-1"></i>
                                    Изменить
                                </a>
                                <form method="post" action="/order/delete/{{ order.id }}"
                                      onsubmit="return confirm('Удалить заказ #{{ order.id }}?');">
                                    <button type="submit" class="btn btn-danger">
                                        <i class="bi bi-trash"></i> Удалить
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="text-center mt-5">
            <a href="/catalog" class="btn btn-outline-primary btn-lg">
                <i class="bi bi-arrow-left me-2"></i>
                Назад к каталогу
            </a>
        </div>
    {% endif %}

    <style>
        .order-card {
            border-radius: 15px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .order-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
        }

        .order-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--primary-color), var(--success-color));
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .order-card:hover::before {
            transform: scaleX(1);
        }

        .badge {
            font-size: 0.85rem;
            font-weight: 500;
        }

        .price-tag {
            background: linear-gradient(135deg, #f8f9fa, #e9ecef);
            padding: 0.5rem 1rem;
            border-radius: 10px;
            display: inline-block;
        }

        .btn-outline-primary, .btn-outline-danger {
            border-width: 2px;
            border-radius: 10px;
            padding: 8px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .btn-outline-primary:hover {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            border-color: transparent;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(67, 97, 238, 0.3);
        }

        .btn-outline-danger:hover {
            background: linear-gradient(135deg, #dc3545, #bb2d3b);
            border-color: transparent;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(220, 53, 69, 0.3);
        }

        .alert-info {
            background: linear-gradient(135deg, #e3f2fd, #bbdefb);
            border: none;
            border-radius: 20px;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            border: none;
            border-radius: 12px;
            padding: 12px 30px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(67, 97, 238, 0.4);
        }
    </style>
{% endblock %}